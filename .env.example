# --- Arc testnet
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
USDC_ADDRESS=0x3600000000000000000000000000000000000000
EXPLORER_URL=https://explorer.testnet.arc.io

# --- Deployer / operator (generated locally)
DEPLOYER_PRIVATE_KEY=
DEPLOYER_ADDRESS=

# --- Circle
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# --- Anthropic (Haiku only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

FACILITATOR_PRIVATE_KEY=
FACILITATOR_ADDRESS=

# --- Product API storage (Upstash Redis via Vercel Marketplace). Unset = JSON files under agent/data.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Protects GET /api/cron/tick (monitor + treasury + fund-pending) when set.
CRON_SECRET=

# --- Web (web/.env.local): passkey wallets via Circle Modular Wallets
# Circle Console → Keys → Client Key; Wallets → Modular Wallets → Passkey domain = your web domain (and localhost).
NEXT_PUBLIC_CIRCLE_CLIENT_KEY=
NEXT_PUBLIC_CIRCLE_CLIENT_URL=https://modular-sdk.circle.com/v1/rpc/w3s/buidl
NEXT_PUBLIC_HOROS_API=http://localhost:4021
